# Copy to .env for local overrides. Never commit .env.
# Environment: "demo" (default, noindex) or "production" (canonical https://kettlebellszeged.hu)
PUBLIC_ENV=demo
# Where the intro video is served from. Video files are NOT in Git; upload them separately.
# Defaults to the locally generated file (scripts/encode-video.sh).
PUBLIC_VIDEO_SRC=/video/intro.mp4
# E-mail address for the "E-mail küldése" button (not provided yet)
PUBLIC_CONTACT_EMAIL=
