# ---------------------------------------------------------------
# Video files: NEVER commit (large binaries, hosted separately).
# The local original stays in assets/ for development only.
# ---------------------------------------------------------------
assets/video.mp4
*.mp4
*.m4v
*.mov
*.webm
*.mkv
*.avi
# Optimized/generated web video outputs, wherever the build puts them
public/video/
public/videos/
src/assets/video/
dist/video/

# Dependencies and build output
node_modules/
dist/
.astro/

# Environment configuration (local values; keep only an .env.example in Git)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Generated by scripts/sync-assets.mjs from assets/ (do not edit, do not commit)
public/spline/
public/fonts/
public/img/
