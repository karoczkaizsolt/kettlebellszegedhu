---
// Figma: hero title (desktop 2114:129/128, mobile 2114:202/330) + StrongFirst logo.
---

<header class="hero">
  <h1 class="hero__title">
    <span class="hero__eyebrow">SFG Kettlebell személyi és<br class="br-eyebrow" /> csoportos edzések Szegeden 2008 óta</span>
    <span class="hero__headline">
      <span class="hero__line hero__line--textured">Az erő <br class="br-mobile" />egy képesség.</span>
      <span class="hero__line hero__line--accent">Szerezd meg!</span>
    </span>
  </h1>
  <div class="logo" role="img" aria-label="StrongFirst"></div>
</header>

<script>
  // Headline texture hand-over: the CSS veil (see global.css) covers the textured line until the image is decoded.
  // The image URL is read from the computed style, so the breakpoint → image mapping lives only in the CSS.
  const line = document.querySelector<HTMLElement>('.hero__line--textured');
  const root = document.documentElement;
  const url = line && /url\(["']?([^"')]+)["']?\)/.exec(getComputedStyle(line).backgroundImage)?.[1];
  if (url) {
    const started = performance.now();
    const image = new Image();
    image.src = url;
    image
      .decode()
      .catch(() => {})
      // Decoded almost at once (warm cache): show it without the cross-fade; otherwise fade the veil out.
      .then(() => {
        root.dataset.texture = performance.now() - started < 120 ? 'instant' : 'ready';
      });
  } else {
    root.dataset.texture = 'instant';
  }
</script>
