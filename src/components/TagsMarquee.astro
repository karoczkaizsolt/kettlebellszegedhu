---
// Mobile/tablet (< 960 px) version of the labels around the kettlebell (Figma mobile frames 2119:162 / 2119:148,
// rows `row 1` / `row 2`): two rows of labels that move horizontally and loop without a seam. Texts as in the
// mobile Figma frame. Desktop keeps the static `Tags` grid; this component is hidden from 960 px up.
// Seamless loop: every row is the same group of labels repeated `copies` times and the track moves by exactly one
// group (-100/copies %); the group carries its own trailing gap, so the joint is invisible. Only the first group is
// exposed to assistive technology.
const rows = [
  {
    direction: 'left',
    duration: '39s',
    copies: 3,
    tags: ['mobilitás és hajlékonyság', 'ízületkímélő terhelés', 'kardió és állóképesség', 'testzsírcsökkentés'],
  },
  {
    direction: 'right',
    duration: '27s',
    copies: 4,
    tags: ['robbanékony erő', 'izomépítés', 'törzserő', 'fogáserő'],
  },
];
---

<div class="tags-marquee" data-tags-marquee>
  {
    rows.map((row) => (
      <div class="marquee__row" data-direction={row.direction} style={`--marquee-duration: ${row.duration}; --marquee-copies: ${row.copies}`}>
        <div class="marquee__track">
          {Array.from({ length: row.copies }, (_, copy) => (
            <ul class="marquee__group" aria-hidden={copy > 0 ? 'true' : undefined}>
              {row.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))
  }
</div>

<script>
  import { sceneMobile } from '../config';

  // Phones only: the label block is centred vertically in the free space between the hero (headline + logo) and the
  // info card, so the gap above equals the gap below at any screen height. Tablet and desktop keep their CSS position.
  const block = document.querySelector<HTMLElement>('[data-tags-marquee]');
  const hero = document.querySelector<HTMLElement>('.hero');
  const card = document.querySelector<HTMLElement>('.banner');
  const phone = window.matchMedia(`(max-width: ${sceneMobile.maxWidth}px)`);

  function place() {
    if (!block || !hero || !card) return;
    if (!phone.matches) {
      block.style.top = ''; // back to the stylesheet position
      return;
    }
    // offsetTop/offsetHeight ignore transforms, so the result is the same in the default and the active state
    const heroBottom = hero.offsetTop + hero.offsetHeight;
    const free = card.offsetTop - heroBottom - block.offsetHeight;
    block.style.top = `${Math.round(heroBottom + Math.max(free, 0) / 2)}px`;
  }

  if (block && hero && card) {
    place();
    phone.addEventListener('change', place);
    const ro = new ResizeObserver(place);
    ro.observe(document.documentElement);
    ro.observe(card);
    ro.observe(hero);
    document.fonts?.ready.then(place);
  }
</script>
