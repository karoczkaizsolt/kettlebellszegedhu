---
import iconInfo from '../assets/figma/icon-info.svg';
---

<!-- Figma "info": icon only; the credit line appears on hover/focus. Desktop only (not part of the mobile frames). -->
<div class="credit">
  <p class="credit__text" id="credit-text">2026 © Varga Tamás • KZS Design</p>
  <button type="button" class="credit__btn" aria-describedby="credit-text" aria-label="Információ a weboldalról">
    <img src={iconInfo.src} width="24" height="24" alt="" />
  </button>
</div>
