---
import { splineSceneUrl, sceneMobile, sceneState, PAGE_STATE_ATTRIBUTE, PAGE_STATES } from '../config';
---

<!-- The Spline scene owns the kettlebell animation, colour change and hover/tap logic.
     This component only hosts the canvas and loads the scene after the first render. -->
<div
  class="scene"
  data-scene
  data-scene-state="idle"
  data-scene-url={splineSceneUrl}
  data-mobile-max={sceneMobile.maxWidth}
  data-mobile-dolly={sceneMobile.dollyBack}
  data-camera-name={sceneMobile.cameraName}
  data-state-variable={sceneState.variableName}
  data-state-poll={sceneState.pollMs}
  data-state-attribute={PAGE_STATE_ATTRIBUTE}
  data-state-default={PAGE_STATES.default}
  data-state-active={PAGE_STATES.active}
  aria-hidden="true"
>
  <canvas data-scene-canvas></canvas>
</div>

<script>
  const host = document.querySelector<HTMLElement>('[data-scene]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-scene-canvas]');

  // The scene was exported for WebGPU only: browsers without a WebGPU adapter cannot render it.
  async function hasWebGPU(): Promise<boolean> {
    try {
      const gpu = (navigator as Navigator & { gpu?: { requestAdapter(): Promise<unknown> } }).gpu;
      return !!gpu && !!(await gpu.requestAdapter());
    } catch {
      return false;
    }
  }

  // Phones: show the composition smaller by pulling the scene camera back along its viewing direction (runtime
  // only, the scene file is untouched). The canvas keeps its full size, so no backdrop edge appears.
  function applyMobileComposition(app: {
    findObjectByName(name: string): { position: { y: number; z: number }; rotation: { x?: number; _x?: number } } | undefined;
  }) {
    if (!host) return;
    const dolly = Number(host.dataset.mobileDolly);
    const cam = app.findObjectByName(host.dataset.cameraName as string);
    if (!cam || !dolly) return;
    const rx = cam.rotation._x ?? cam.rotation.x ?? 0;
    const base = { y: cam.position.y, z: cam.position.z };
    const query = window.matchMedia(`(max-width: ${host.dataset.mobileMax}px)`);
    const apply = () => {
      const d = query.matches ? dolly : 0;
      cam.position.y = base.y - Math.sin(rx) * d; // back = -forward, forward = (0, sin(rx), -cos(rx))
      cam.position.z = base.z + Math.cos(rx) * d;
    };
    apply();
    query.addEventListener('change', apply);
  }

  // Mirror the scene's own `kettlebellLifted` variable into the page state. The page never decides the state and
  // never adds its own hover/tap detection: the scene's Hitbox/MouseHover/MouseDown logic stays the only source.
  function mirrorSceneState(app: {
    getVariable(name: string): number | boolean | string;
    addEventListener(name: string, cb: () => void): void;
  }) {
    if (!host) return;
    const root = document.documentElement;
    const attribute = host.dataset.stateAttribute as string;
    const variable = host.dataset.stateVariable as string;
    let last: string | undefined;
    const sync = () => {
      let lifted = false;
      try {
        lifted = app.getVariable(variable) === true;
      } catch {
        return;
      }
      const next = lifted ? (host.dataset.stateActive as string) : (host.dataset.stateDefault as string);
      if (next !== last) {
        last = next;
        root.setAttribute(attribute, next);
      }
    };
    sync();
    // The scene updates the variable inside its own event handler: look again a moment after its events.
    for (const name of ['mouseHover', 'mouseDown', 'mouseUp']) {
      app.addEventListener(name, () => {
        requestAnimationFrame(sync);
        setTimeout(sync, 60);
      });
    }
    const timer = window.setInterval(() => {
      if (!document.hidden) sync();
    }, Number(host.dataset.statePoll));
    window.addEventListener('pagehide', () => window.clearInterval(timer), { once: true });
  }

  async function loadScene() {
    if (!host || !canvas) return;
    if (!(await hasWebGPU())) {
      // Fallback: the page stays fully usable without the 3D scene (the runtime is not even downloaded).
      host.dataset.sceneState = 'unsupported';
      return;
    }
    host.dataset.sceneState = 'loading';
    try {
      const { Application } = await import('@splinetool/runtime');
      const app = new Application(canvas);
      await app.load(host.dataset.sceneUrl as string);
      applyMobileComposition(app);
      mirrorSceneState(app);
      host.dataset.sceneState = 'ready';
    } catch (error) {
      host.dataset.sceneState = 'failed';
      console.warn('Spline scene could not be loaded', error);
    }
  }

  // Do not compete with the first render: start after load, when the browser is idle.
  const start = () => {
    const idle = (window as unknown as { requestIdleCallback?: (cb: () => void) => void }).requestIdleCallback;
    idle ? idle(loadScene) : setTimeout(loadScene, 200);
  };
  if (document.readyState === 'complete') start();
  else window.addEventListener('load', start, { once: true });
</script>
