---
import iconActive from '../assets/figma/icon-video-active.svg';
---

<button type="button" class="video-tab" data-video-open aria-haspopup="dialog" aria-controls="video-modal">
  <span class="video-tab__icon">
    <!-- default icon colour: light gray (#E0E0E0), the same artwork as the active icon -->
    <img class="icon-default" src={iconActive.src} width="24" height="24" alt="" />
    <img class="icon-active" src={iconActive.src} width="24" height="24" alt="" />
  </span>
  <span class="video-tab__label">Ismerd meg<br class="br-desktop" /> az edzéseket</span>
</button>

<script>
  // Entrance of the tab, once per page load, never restarted by anything:
  // - phones/tablets: a CSS animation (global.css) gated by `data-intro-done`, set when it has finished;
  // - desktop: a single Web Animation created here, once (this module script runs once per page load; it is not bound to
  //   the cascade, so no class/state/resize/modal change and no Safari style recalculation can replay it). Until it
  //   starts the tab is hidden by `data-tab-intro="pending"` (set before first paint in the head).
  const root = document.documentElement;
  const tab = document.querySelector<HTMLElement>('.video-tab');
  const markDone = () => root.setAttribute('data-intro-done', '');

  if (tab && root.getAttribute('data-tab-intro') === 'pending') {
    const ease = getComputedStyle(root).getPropertyValue('--ease-lift').trim() || 'cubic-bezier(0.22, 0.61, 0.36, 1)';
    const intro = tab.animate(
      [
        { translate: 'calc(100% + 1px) 0', visibility: 'visible' },
        { translate: '0 0', visibility: 'visible' },
      ],
      { duration: 1000, delay: 900, easing: ease, fill: 'both' },
    );
    intro.finished
      .then(() => {
        // same task: reveal-state removed, then the finished animation released, so no frame shows an intermediate state
        root.removeAttribute('data-tab-intro');
        intro.cancel();
      })
      .catch(() => root.removeAttribute('data-tab-intro'));
  }

  tab?.addEventListener('animationend', (event) => {
    if ((event as AnimationEvent).animationName === 'enter-from-bottom') markDone();
  });
  window.addEventListener('load', () => window.setTimeout(markDone, 2500), { once: true });
</script>
