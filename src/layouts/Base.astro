---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { canonicalBase, isProduction, PAGE_STATE_ATTRIBUTE, PAGE_STATES } from '../config';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = canonicalBase ? new URL('/', canonicalBase).href : undefined;
const stateAttr = { [PAGE_STATE_ATTRIBUTE]: PAGE_STATES.default };
---

<!doctype html>
<html lang="hu" {...stateAttr}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!isProduction && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#000000" />
    <link rel="preload" href="/fonts/BasementGrotesque-Black.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/SometypeMono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SometypeMono-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
